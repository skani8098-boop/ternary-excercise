package kanishka;
import java.util.Scanner;
public class smallest {

	public static void main(String[] args) {
		Scanner Sc=new Scanner(System.in);
		System.out.println("Enter a:");
		int a= Sc.nextInt();
		System.out.println("Enter b:");
		int b=Sc.nextInt();
		int result=(a<b)?a:b;
		System.out.println("smallest:"+result);

	}

}
